# Plantilla de claves: copia este fichero a .env y rellena los valores.
# .env no sube al repo; Docker lo lee con `env_file` y nunca entra en la imagen.

# LinkedIn: actor de fantastic.jobs en Apify (conector activo, linkedin-fantastic-apify).
APIFY_TOKEN=

# LinkedIn, plan B: la misma API en RapidAPI (linkedin-fantastic-rapidapi).
RAPIDAPI_KEY=

# Opcional: URL de ping de Healthchecks. La ingesta avisa con /start al empezar y,
# tras puntuar, con ok o con /fail y las alertas. Vacía, no se avisa.
HEALTHCHECKS_URL=

# Opcionales que se dejan comentados: un valor vacío no vale como «por defecto».
# Host de la API de LinkedIn en RapidAPI (por defecto, linkedin-job-search-api.p.rapidapi.com).
# RAPIDAPI_HOST_LINKEDIN=
# Carpeta de datos (SQLite, perfil, logs, copias). Por defecto, data/ del repo; la imagen
# de Docker ya la fija en /app/data. Fuera de Docker, tiene que estar en el entorno al
# arrancar (exportada en la shell): desde .env llega tarde.
# JOB_RADAR_DATOS=

# NO definas ANTHROPIC_API_KEY si puntúas con la suscripción de Claude (`claude -p`):
# con ella, `claude -p` cobraría por token en vez de usar la suscripción (el conector
# la quita del entorno por si acaso, pero no conviene tenerla).
