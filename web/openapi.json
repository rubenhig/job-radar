       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Ciudad"
      }
     },
     {
      "name": "etiqueta",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "enum": [
          "top",
          "no_top",
          "sin"
         ],
         "type": "string"
