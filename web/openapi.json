        {
         "type": "null"
        }
       ],
       "title": "Etiqueta"
      }
     },
     {
      "name": "dias",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "integer",
         "exclusiveMinimum": 0
        },
        {
         "type": "null"
        }
       ],
       "title": "Dias"
      }
     },
     {
      "name": "nota_min",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "integer",
         "maximum": 100,
         "minimum": 0
        },
        {
         "type": "null"
        }
       ],
       "title": "Nota Min"
      }
     },
     {
      "name": "puntuado",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ],
       "title": "Puntuado"
      }
     },
     {
      "name": "descartados",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean",
       "default": false,
       "title": "Descartados"
      }
     },
     {
      "name": "nuevos_desde",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Nuevos Desde"
      }
     },
     {
      "name": "orden",
      "in": "query",
      "required": false,
      "schema": {
       "enum": [
        "recientes",
        "publicadas",
        "vias",
        "nota"
       ],
       "type": "string",
       "default": "recientes",
       "title": "Orden"
      }
     },
     {
      "name": "limite",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 200,
       "exclusiveMinimum": 0,
       "default": 50,
       "title": "Limite"
      }
     },
     {
      "name": "desde",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "minimum": 0,
       "default": 0,
       "title": "Desde"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/PaginaPuestos"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
