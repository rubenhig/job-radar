        {
         "type": "null"
        }
       ],
       "title": "Fuente"
      }
     },
     {
      "name": "modalidad",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        {
         "type": "null"
        }
       ],
       "title": "Modalidad"
      }
     },
     {
      "name": "ciudad",
      "in": "query",
      "required": false,
